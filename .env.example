# Nonsecret settings only. Keep loopback binds; use an authenticated TLS ingress
# when exposing the stack remotely. Changing a port also requires updating URLs.
GATEWAY_PORT=8000
API_PORT=8001
KEYCLOAK_PORT=8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
PROXYLENS_REDIRECT_URI=http://localhost:8001/oidc/callback
# Gateway routing: explicitly verify and populate deploy/gateway/routes.json.
PROXYLENS_CPA_INSTANCE_ID=primary
PROXYLENS_CPAMP_INSTANCE_ID=primary
PROXYLENS_WORKER_INTERVAL_SECONDS=5
PROXYLENS_RETENTION_INTERVAL_SECONDS=3600
PROXYLENS_GROUP_RECONCILE_INTERVAL_SECONDS=3600
PROXYLENS_RETENTION_REQUEST_DAYS=90
PROXYLENS_RETENTION_PROJECTION_DAYS=90
PROXYLENS_RETENTION_OUTBOX_DAYS=90
PROXYLENS_RETENTION_AUDIT_DAYS=365
PROXYLENS_RETENTION_REMOTE_OBSERVATION_DAYS=90
PROXYLENS_MAX_BODY_BYTES=4194304
PROXYLENS_TOTAL_TIMEOUT=120
PROXYLENS_IDLE_TIMEOUT=30
# Existing real, locally operated Langfuse; e.g. http://host.docker.internal:3000.
# Leave empty to keep metadata export disabled.
LANGFUSE_BASE_URL=
